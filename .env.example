# AWS Bedrock Configuration
AWS_REGION=ap-northeast-2

# AWS 자격 증명 (선택 사항)
# 설정하지 않으면 AWS CLI 설정(~/.aws/credentials)을 사용합니다
# aws configure로 설정했다면 아래 두 줄은 주석 처리하거나 삭제하세요
# AWS_ACCESS_KEY_ID=your-access-key-here
# AWS_SECRET_ACCESS_KEY=your-secret-key-here

# Bedrock Model Configuration
# Default: Claude Sonnet 4.5
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-v2:0

# Application Configuration
LOG_LEVEL=INFO
CONVERSATION_DB_PATH=./data/conversations.db

# Grafana MCP Configuration
# Grafana 인스턴스 URL과 API 키를 설정하세요
GRAFANA_URL=https://your-grafana-instance.com
GRAFANA_SERVICE_ACCOUNT_TOKEN=your-grafana-service-account-token

# CloudWatch MCP Configuration
# AWS 프로필을 사용하거나 위의 AWS 자격 증명을 사용합니다
# AWS_REGION이 설정되어 있으면 자동으로 CloudWatch MCP에 연결합니다
# AWS_PROFILE=default

# AWS API MCP Configuration
# EC2 인스턴스 조회, S3 버킷 목록 등 AWS CLI 명령 실행
# CloudWatch MCP와 동일한 AWS 자격 증명을 사용합니다

# MCP Server URLs (Optional - defaults to docker-compose service names)
# 모든 MCP 서버는 Streamable HTTP 모드로 실행되며 /mcp 엔드포인트 사용
# GRAFANA_MCP_URL=http://grafana-mcp:8000/mcp
# CLOUDWATCH_MCP_URL=http://cloudwatch-mcp:8000/mcp
# AWS_API_MCP_URL=http://aws-api-mcp:8000/mcp
# AWS_DOCS_MCP_URL=http://aws-docs-mcp:8000/mcp